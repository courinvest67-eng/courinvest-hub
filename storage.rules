rules_version = '2';
// Courinvest Hub v561
// Publicar no Firebase console (Storage → Regras) ou: firebase deploy --only storage
//
// O app só sobe PDF de relatório (relatorios/{cliente}/{mês}.pdf) pela conta admin.
// Cliente do painel não lê Storage pelo SDK.
// Link de download que o e-mail já enviou leva um token (?token=) e continua abrindo:
// esse token não passa por estas regras. Sem o token, a leitura direta é negada.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() == "courinvest.67@gmail.com";
    }
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
